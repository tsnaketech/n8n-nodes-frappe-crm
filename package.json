{
	"name": "n8n-nodes-frappe-crm",
	"version": "0.1.0",
	"description": "n8n node for Frappe CRM: leads, deals, contacts, organizations, notes and tasks",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-frappe-crm#readme",
	"keywords": [
		"n8n-community-node-package",
		"frappe",
		"frappe-crm",
		"crm",
		"sales",
		"leads"
	],
	"author": {
		"name": "tsnaketech",
		"email": "snaketech@proton.me",
		"url": "https://github.com/tsnaketech"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-frappe-crm.git"
	},
	"bugs": {
		"url": "https://github.com/tsnaketech/n8n-nodes-frappe-crm/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc && gulp build:icons",
		"rebuild": "npm run clean && npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials package.json gulpfile.js --write",
		"format:check": "prettier nodes credentials package.json gulpfile.js --check",
		"lint": "eslint nodes credentials package.json --ignore-pattern '**/*.test.ts'",
		"lint:fix": "eslint nodes credentials package.json --ignore-pattern '**/*.test.ts' --fix",
		"test": "vitest run --exclude 'dist/**'",
		"test:watch": "vitest --exclude 'dist/**'",
		"ci": "npm run format:check && npm run lint && npm run test",
		"prepack": "npm run rebuild"
	},
	"files": [
		"dist",
		"README.fr.md",
		"README.es.md",
		"README.de.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FrappeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FrappeCrm/FrappeCrm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.0",
		"eslint": "9.39.5",
		"gulp": "5.0.1",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"rimraf": "6.1.3",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
