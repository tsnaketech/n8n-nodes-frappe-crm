{
	"name": "n8n-nodes-frappe-crm",
	"version": "0.1.0",
	"description": "n8n node for Frappe CRM: leads, deals, contacts, organizations, notes and tasks",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-frappe-crm#readme",
	"keywords": [
		"n8n-community-node-package",
		"frappe",
		"frappe-crm",
		"crm",
		"sales",
		"leads"
	],
	"author": {
		"name": "tsnaketech",
		"email": "snaketech@proton.me",
		"url": "https://github.com/tsnaketech"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-frappe-crm.git"
	},
	"bugs": {
		"url": "https://github.com/tsnaketech/n8n-nodes-frappe-crm/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"README.fr.md",
		"README.es.md",
		"README.de.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FrappeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FrappeCrm/FrappeCrm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.0",
		"eslint": "9.39.5",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": ">=2"
	}
}
