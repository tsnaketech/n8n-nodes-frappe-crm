		"credentials": [
			"dist/credentials/FrappeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FrappeCrm/FrappeCrm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"release-it": "21.0.0",
		"typescript": "~5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
